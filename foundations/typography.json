          "fontWeight": "{font.weight.light}",
          "letterSpacing": "{font.tracking.display}"
        }
      }
    },
    "3": {
      "$description": "Section display. Ratio ≈ 0.9.",
      "wide": {
        "$type": "typography",
        "$value": {
          "fontSize": "88px",
          "lineHeight": "80px",
          "fontFamily": "{font.family.display}",
          "fontWeight": "{font.weight.light}",
          "letterSpacing": "{font.tracking.display}"
        }
      },
      "desktop": {
