        "$value": {
          "fontSize": "72px",
          "lineHeight": "68px",
          "fontFamily": "{font.family.display}",
          "fontWeight": "{font.weight.light}",
          "letterSpacing": "{font.tracking.display}"
        }
      },
      "mobile": {
