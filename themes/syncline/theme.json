{
  "$description": "Theme B · Syncline — a public dance companion app. Fills the foundations' contracts; the default accent is the Cloud energy form (teal). Six energy forms live under `energy.*` and become modes in Figma and data-attribute scopes in CSS.",
  "theme": {
    "font": {
      "body": {
        "$type": "fontFamily",
        "$value": [
          "Inter",
          "system-ui",
          "sans-serif"
        ]
      },
      "display": {
        "$type": "fontFamily",
        "$value": [
          "New York",
          "Iowan Old Style",
          "Georgia",
          "serif"
        ],
        "$description": "Apple's optical serif in Safari/iOS; Georgia elsewhere. Bold, for the screen titles."
      },
      "mono": {
        "$type": "fontFamily",
        "$value": [
          "Inter",
          "system-ui",
          "sans-serif"
        ],
        "$description": "No mono voice in this product; the role aliases to body so labels still resolve."
      }
    },
    "accent": {
      "$description": "Default accent = Cloud. The build swaps in another energy form by name.",
      "light": {
        "base": {
          "$type": "color",
          "$value": "#54b8ab"
        },
        "strong": {
          "$type": "color",
          "$value": "#1f7a77"
        },
        "soft": {
          "$type": "color",
          "$value": "#e0ece6"
        },
        "on": {
          "$type": "color",
          "$value": "#121310"
        },
        "signal": {
          "$type": "color",
          "$value": "{theme.signal}"
        }
      },
      "dark": {
        "base": {
          "$type": "color",
          "$value": "#54b8ab"
        },
        "strong": {
          "$type": "color",
          "$value": "#54b8ab"
        },
        "soft": {
          "$type": "color",
          "$value": "#1e312c"
        },
        "on": {
          "$type": "color",
          "$value": "#121310"
        },
        "signal": {
          "$type": "color",
          "$value": "{theme.signal}"
        }
      }
    },
    "signal": {
      "$type": "color",
      "$value": "#cc3b12",
      "$description": "Attention / error — the Fuzz strong. 4.6:1 on light canvas."
    },
    "shadow": {
      "hue": {
        "$type": "color",
        "$value": "#152a55",
        "$description": "Navy, not black: every Syncline shadow in the prototype was rgba(21,42,85,x). Elevation geometry stays the base's."
      }
    },
    "canvas": {
      "$type": "color",
      "$value": "{neutral.50}",
      "$description": "Overrides semantic.bg.canvas: the prototype's #f7f4ef is one step lighter than the site's paper."
    }
  },
  "energy": {
    "$description": "Six energy forms, each a full accent set in both modes. base = the form's own colour from the prototype's data.ts; strong = base pushed until it reads as text at ≥ 4.5:1 on the canvas; soft = 14–18% tint for selected states; on = ink or paper, whichever contrasts more with base. Derived by build/derive-accent.py, not by eye.",
    "cloud": {
      "$description": "Cloud — Calm · Gentle · Flowing",
      "light": {
        "base": {
