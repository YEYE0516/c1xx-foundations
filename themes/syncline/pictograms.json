{
  "$description": "Syncline dance-style pictograms. Source of truth for build/pictograms.py and the Figma `Pictogram` set. Same construction rules as the UI icons, doubled: 48 box, 40 live area (4 padding), stroke 4, round caps and joins — so stroke : box = 1 : 12 exactly as 2 : 24. One grammar for all eight: THREE strokes, one per colour slot, no fills, no guides; every glyph fills the 40 × 40 live area (stacked rows at y 12 / 24 / 36 or columns at x 12 / 24 / 36). Idle = cloud / jelly / fuzz, Active = cloud / bloom / star.",
  "grid": {
    "size": 48,
    "liveArea": 40,
    "padding": 4,
    "stroke": 4,
    "terminals": "round"
  },
  "rules": [
    "exactly three strokes, slot 0 → 1 → 2 from top-left to bottom-right",
    "stroke 4 everywhere; no filled shapes, no dashes, no opacity",
    "the three strokes fill the live area: stacked glyphs span x 6–42, columned glyphs span y 6–42",
    "stroke pitch 12 (rows at 12 / 24 / 36) so adjacent strokes keep ≥ 6 clear",
    "one motif per style, drawn so it still reads at 32 px: staircase · sine · free curve · arc · arch · S · ring · tread"
  ],
  "slots": {
    "idle": [
      "cloud",
      "jelly",
      "fuzz"
    ],
    "active": [
      "cloud",
      "bloom",
      "star"
    ]
  },
